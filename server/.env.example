# ==============================================================================
# DayFlow Server Environment Configuration
# ==============================================================================

# Environment: 'development' or 'production'
NODE_ENV=production

# API Server Port (internal)
PORT=5000

# Strict CORS allowed origins (comma-separated domains, e.g. https://dayflow.app)
ALLOWED_ORIGINS=https://localhost,https://127.0.0.1

# JWT Secret for session tokens (Must be a secure random 64-char string in production)
# Generate via: openssl rand -hex 32
JWT_SECRET=replace_with_secure_random_64_character_hex_secret

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=

# ==============================================================================
# Database Configuration (Choose either DATABASE_URL or discrete parameters)
# ==============================================================================

# Option A: Cloud Managed Connection String (AWS RDS, Supabase, Neon, Railway)
# DATABASE_URL=postgresql://user:password@cloud-host.com:5432/dayflow_db?sslmode=require
# DB_SSL=true

# Option B: Discrete Parameters (Local / Docker Compose)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dayflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_SSL=false
